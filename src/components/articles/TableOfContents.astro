---
import type { MarkdownHeading } from 'astro';
import type { Locale } from '@config/locales';
import { useTranslations } from '@i18n/index';

interface Props {
  headings: readonly MarkdownHeading[];
  locale: Locale;
  class?: string;
}

const { headings, locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);

/*
 * Only h2 and h3 make a useful outline. h1 is the article title, and anything
 * deeper turns the contents into a second article.
 */
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 1 && (
  <nav aria-labelledby="toc-heading" class:list={['text-sm', className]} data-toc>
    <h2 id="toc-heading" class="font-mono text-micro tracking-[0.12em] text-ink-subtle uppercase">
      {t.article.tableOfContents}
    </h2>

    <ol class="mt-3 flex flex-col gap-1 border-s border-border">
      {items.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            class:list={[
              '-ms-px block border-s border-transparent py-1 text-ink-muted transition-colors',
              'hover:border-border-strong hover:text-ink',
              'aria-[current=true]:border-accent aria-[current=true]:text-accent',
              heading.depth === 3 ? 'ps-6' : 'ps-3',
            ]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  /*
   * Marks the heading currently being read. Pure enhancement: the contents are
   * complete, ordered and navigable with this script absent or failing.
   */
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>(
      [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((link) => [
        link.dataset.tocLink ?? '',
        link,
      ]),
    );

    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((element): element is HTMLElement => element !== null);

    let active: HTMLAnchorElement | undefined;

    const setActive = (id: string): void => {
      const link = links.get(id);
      if (!link || link === active) return;
      active?.removeAttribute('aria-current');
      link.setAttribute('aria-current', 'true');
      active = link;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible[0]?.target.id) setActive(visible[0].target.id);
      },
      /* Focus on a band just below the sticky header. */
      { rootMargin: '-88px 0px -70% 0px', threshold: 0 },
    );

    for (const heading of headings) observer.observe(heading);
  }
</script>
