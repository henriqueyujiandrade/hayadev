---
import type { Locale } from '@config/locales';
import { interpolate, useTranslations } from '@i18n/index';
import type { LocalizedArticle } from '@utils/content';
import { formatDate, toISODate } from '@utils/date';
import { localizedPath } from '@utils/routes';

interface Props {
  article: LocalizedArticle;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
  /** `featured` gives the lead article more room and shows its description. */
  variant?: 'default' | 'featured';
}

const { article, locale, headingLevel: Heading = 'h3', variant = 'default' } = Astro.props;
const t = useTranslations(locale);

const { data } = article;
const href = localizedPath('articles', locale, article.slug);
const readingLabel = interpolate(t.article.readingTime, { minutes: article.readingTime });
---

<article
  class:list={[
    'group relative flex flex-col gap-3',
    variant === 'featured'
      ? 'rounded-xl border border-border bg-surface p-7 transition-colors hover:border-border-strong'
      : 'border-b border-border py-6 first:pt-0',
  ]}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.6875rem] text-ink-subtle">
    <span class="text-accent uppercase">{t.categories[data.category]}</span>
    <span aria-hidden="true">·</span>
    <time datetime={toISODate(data.pubDate)}>{formatDate(data.pubDate, locale)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingLabel}</span>
  </div>

  <Heading class:list={['font-serif text-ink', variant === 'featured' ? 'text-h2' : 'text-h3']}>
    <a href={href} class="after:absolute after:inset-0 after:content-[''] hover:text-accent">
      {data.title}
    </a>
  </Heading>

  <p class="max-w-measure text-[0.9375rem] text-ink-muted">{data.description}</p>

  <ul class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
    {data.tags.slice(0, 4).map((tag) => (
      <li class="font-mono text-[0.6875rem] text-ink-subtle">{`#${tag}`}</li>
    ))}
  </ul>
</article>
