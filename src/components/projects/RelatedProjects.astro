---
import { ArrowUpRight } from '@lucide/astro';
import type { Locale } from '@config/locales';
import { useTranslations } from '@i18n/index';
import type { LocalizedProject } from '@utils/content';
import { localizedPath } from '@utils/routes';

interface Props {
  projects: readonly LocalizedProject[];
  locale: Locale;
  title: string;
}

const { projects, locale, title } = Astro.props;
const t = useTranslations(locale);
---

{projects.length > 0 && (
  <section aria-labelledby="related-projects-heading" class="flex flex-col gap-5">
    <h2
      id="related-projects-heading"
      class="font-mono text-micro tracking-[0.12em] text-ink-subtle uppercase"
    >
      {title}
    </h2>

    <ul class="flex flex-col gap-3">
      {projects.map((project) => (
        <li class="group relative flex items-center justify-between gap-4 rounded-lg border border-border bg-surface p-5 transition-colors hover:border-border-strong">
          <div class="flex flex-col gap-1">
            <p class="font-mono text-[0.6875rem] text-accent uppercase">
              {t.projectTypes[project.data.projectType]}
            </p>
            <h3 class="font-semibold text-ink">
              <a
                href={localizedPath('projects', locale, project.slug)}
                class="after:absolute after:inset-0 after:content-['']"
              >
                {project.data.title}
              </a>
            </h3>
            <p class="text-sm text-ink-muted">{project.data.shortDescription}</p>
          </div>

          <ArrowUpRight
            class="size-5 shrink-0 text-ink-subtle transition-colors group-hover:text-accent"
            aria-hidden="true"
          />
        </li>
      ))}
    </ul>
  </section>
)}
