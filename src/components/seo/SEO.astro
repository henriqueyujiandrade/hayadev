---
import { HTML_LANG, OG_LOCALE, type Locale } from '@config/locales';
import { seoDefaults } from '@config/seo';
import { person } from '@config/person';
import { siteConfig } from '@config/site';
import type { SeoData } from '@utils/seo';
import { feedPath } from '@utils/routes';
import { absoluteUrl } from '@utils/url';

interface Props {
  locale: Locale;
  seo: SeoData;
}

const { locale, seo } = Astro.props;
const { width, height } = siteConfig.defaultOgImageSize;
const feedTitle = `${siteConfig.name} — ${HTML_LANG[locale]}`;
---

{/*
  Every indexable document gets the same complete head: title, description,
  canonical, the hreflang set, Open Graph, Twitter and the RSS auto-discovery
  link. Pages never assemble this by hand, so a new route cannot ship without it.
*/}
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
<meta name="robots" content={seo.noindex ? seoDefaults.robotsNoIndex : seoDefaults.robots} />

{seo.alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
))}
{seo.xDefault && <link rel="alternate" hreflang="x-default" href={seo.xDefault} />}

<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:type" content={seo.ogType} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:alt" content={seo.ogImageAlt} />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content={String(height)} />

{seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
{seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}
{seo.ogType === 'article' && (
  <meta property="article:author" content={person.fullName || person.name} />
)}

<meta name="twitter:card" content={seoDefaults.twitterCardType} />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />
<meta name="twitter:image:alt" content={seo.ogImageAlt} />

<meta name="author" content={person.fullName || person.name} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={feedTitle}
  href={absoluteUrl(feedPath(locale))}
/>
