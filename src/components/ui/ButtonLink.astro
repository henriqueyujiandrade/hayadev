---
import { isExternalUrl, relForUrl } from '@utils/url';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  /** Accessible name, when the visible label alone is not descriptive enough. */
  ariaLabel?: string;
  class?: string;
}

const { href, variant = 'secondary', size = 'md', ariaLabel, class: className = '' } = Astro.props;

const external = isExternalUrl(href);

const variants = {
  primary:
    'bg-accent text-accent-contrast border-accent hover:bg-accent-hover hover:border-accent-hover',
  secondary:
    'bg-surface text-ink border-border-control hover:border-ink-muted hover:bg-surface-muted',
  ghost: 'bg-transparent text-ink-muted border-transparent hover:text-ink hover:bg-surface-muted',
} as const;

const sizes = {
  md: 'px-4 py-2 text-[0.9375rem]',
  sm: 'px-3 py-1.5 text-sm',
} as const;
---

<a
  href={href}
  aria-label={ariaLabel}
  rel={relForUrl(href)}
  target={external ? '_blank' : undefined}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md border font-medium',
    'transition-colors duration-150',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</a>
