---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{/* Non-interactive technology or topic label. */}
<span
  class:list={[
    'inline-flex items-center rounded-sm border border-border bg-surface-muted px-2 py-0.5',
    'font-mono text-[0.6875rem] tracking-wide text-ink-muted',
    className,
  ]}
>
  <slot />
</span>
