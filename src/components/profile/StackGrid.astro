---
import type { Locale } from '@config/locales';
import { stack } from '@config/stack';
import { useTranslations } from '@i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/*
  Grouped by layer rather than shown as one undifferentiated cloud: the grouping
  is itself the signal about where the depth is.
*/}
<div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
  {stack.map((group) => (
    <div class="flex flex-col gap-3">
      <h3 class="font-mono text-micro tracking-[0.12em] text-accent uppercase">
        {t.stack[group.id]}
      </h3>
      <ul class="flex flex-col gap-1.5">
        {group.items.map((item) => (
          <li class="text-[0.9375rem] text-ink-muted">{item}</li>
        ))}
      </ul>
    </div>
  ))}
</div>
