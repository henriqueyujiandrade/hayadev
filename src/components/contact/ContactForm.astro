---
import { Check, Copy, Send } from '@lucide/astro';
import { contactForm } from '@config/contact';
import type { Locale } from '@config/locales';
import { useTranslations } from '@i18n/index';
import { isExternalUrl, relForUrl } from '@utils/url';

export interface FallbackChannel {
  label: string;
  href: string;
}

interface Props {
  locale: Locale;
  /** Address offered to write to directly if delivery fails. */
  email: string;
  /** Faster channels offered first when delivery fails, e.g. WhatsApp and LinkedIn. */
  fallbackChannels?: readonly FallbackChannel[];
}

const { locale, email, fallbackChannels = [] } = Astro.props;
const t = useTranslations(locale);

const fieldClass = [
  'w-full rounded-md border border-border-control bg-surface px-3.5 py-2.5',
  'text-[0.9375rem] text-ink placeholder:text-ink-subtle',
  'transition-colors hover:border-ink-muted focus:border-accent focus:outline-none',
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus',
].join(' ');

const labelClass = 'text-sm font-medium text-ink';
---

{/*
  Submissions go to Web3Forms (see src/config/contact.ts), which emails them to
  the site owner; the visitor's `email` field becomes the reply-to address.

  It is a plain HTML form posting to the API, so it works without JavaScript
  (the visitor lands on the Web3Forms confirmation page). The script upgrades it
  to an in-page submission with a result message. It is a few lines of DOM work,
  so it stays vanilla rather than shipping the React runtime for one form.
*/}
<form data-contact-form action={contactForm.endpoint} method="POST" class="flex flex-col gap-5">
  <input type="hidden" name="access_key" value={contactForm.accessKey} />
  <input type="hidden" name="from_name" value={contactForm.fromName} />
  {/* Honeypot: invisible to people, ticked by bots, rejected by Web3Forms. */}
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label for="contact-name" class={labelClass}>
        {t.contact.nameLabel}
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        placeholder={t.contact.namePlaceholder}
        class={fieldClass}
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="contact-email" class={labelClass}>
        {t.contact.emailFieldLabel}
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        maxlength="254"
        autocomplete="email"
        placeholder={t.contact.emailPlaceholder}
        class={fieldClass}
      />
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <label for="contact-subject" class={labelClass}>
      {t.contact.subjectLabel}
    </label>
    <input
      id="contact-subject"
      name="subject"
      type="text"
      required
      maxlength="150"
      autocomplete="off"
      placeholder={t.contact.subjectPlaceholder}
      class={fieldClass}
    />
  </div>

  <div class="flex flex-col gap-2">
    <label for="contact-message" class={labelClass}>
      {t.contact.messageLabel}
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="8"
      maxlength="5000"
      placeholder={t.contact.messagePlaceholder}
      class:list={[fieldClass, 'min-h-40 resize-y leading-relaxed']}
    ></textarea>
  </div>

  <div>
    <button
      type="submit"
      data-label-sending={t.contact.sending}
      class="inline-flex items-center justify-center gap-2 rounded-md border border-accent bg-accent px-4 py-2 text-[0.9375rem] font-medium text-accent-contrast transition-colors duration-150 hover:border-accent-hover hover:bg-accent-hover disabled:cursor-wait disabled:opacity-70"
    >
      <Send class="size-4" aria-hidden="true" />
      <span data-submit-label>{t.contact.submit}</span>
    </button>
  </div>

  <div role="status" class="text-sm">
    <p
      hidden
      data-contact-success
      class="rounded-md border border-accent-line bg-accent-soft p-4 font-medium text-accent"
    >
      {t.contact.success}
    </p>

    <div
      hidden
      data-contact-error
      class="flex flex-col gap-3 rounded-md border border-border bg-surface-muted/50 p-4 text-ink-muted"
    >
      {/*
        Web3Forms documents no distinct answer for a spent monthly quota, so
        every failure — quota, IP rate limit, outage, offline visitor — gets
        the same way out rather than a guessed-at reason.
      */}
      <p>{t.contact.error}</p>
      {fallbackChannels.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {fallbackChannels.map((channel) => (
            <a
              href={channel.href}
              rel={relForUrl(channel.href)}
              target={isExternalUrl(channel.href) ? '_blank' : undefined}
              class="inline-flex items-center rounded-md border border-accent bg-accent px-3 py-1.5 text-sm font-medium text-accent-contrast transition-colors hover:border-accent-hover hover:bg-accent-hover"
            >
              {channel.label}
            </a>
          ))}
        </div>
      )}
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${email}`}
          class="font-mono text-[0.8125rem] text-ink underline underline-offset-4"
        >
          {email}
        </a>
        <button
          type="button"
          data-copy-email={email}
          data-label-copied={t.contact.copied}
          class="inline-flex items-center gap-1.5 rounded-md border border-border-control bg-surface px-3 py-1.5 text-sm font-medium text-ink transition-colors hover:border-ink-muted hover:bg-surface-muted"
        >
          <Copy class="copy-icon size-3.5" aria-hidden="true" />
          <Check class="copied-icon size-3.5" aria-hidden="true" />
          <span data-copy-label>{t.contact.copyEmail}</span>
        </button>
      </div>
    </div>
  </div>
</form>

<style>
  .copied-icon {
    display: none;
  }

  [data-copied] .copy-icon {
    display: none;
  }

  [data-copied] .copied-icon {
    display: block;
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector('[data-submit-label]');
    const idleLabel = submitLabel?.textContent ?? '';
    const success = form.querySelector<HTMLElement>('[data-contact-success]');
    const failure = form.querySelector<HTMLElement>('[data-contact-error]');
    const copy = form.querySelector<HTMLButtonElement>('[data-copy-email]');

    function setSending(sending: boolean): void {
      if (submit) submit.disabled = sending;
      if (submitLabel) {
        submitLabel.textContent = sending ? (submit?.dataset.labelSending ?? idleLabel) : idleLabel;
      }
    }

    /* The browser has already run the native validation when `submit` fires. */
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (success) success.hidden = true;
      if (failure) failure.hidden = true;
      setSending(true);

      let delivered = false;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = (await response.json()) as { success?: boolean };
        delivered = response.ok && result.success === true;
      } catch {
        /* Network failure or a non-JSON answer: handled as a failed delivery. */
      }

      setSending(false);
      if (delivered) {
        form.reset();
        if (success) success.hidden = false;
      } else if (failure) {
        /* The typed message is kept, so a retry does not mean writing it again. */
        failure.hidden = false;
      }
    });

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copyEmail ?? '');
      } catch {
        /* Clipboard unavailable: the address is visible right beside the button. */
        return;
      }
      copy.dataset.copied = '';
      const label = copy.querySelector('[data-copy-label]');
      if (label && copy.dataset.labelCopied) label.textContent = copy.dataset.labelCopied;
    });
  }
</script>
