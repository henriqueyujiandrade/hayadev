---
import type { GetStaticPaths } from 'astro';
import ProjectRoute from '@routes/ProjectRoute.astro';
import { projectPaths } from '@routes/paths';

export const getStaticPaths = (() => projectPaths('pt-BR')) satisfies GetStaticPaths;

const { project } = Astro.props;
---

<ProjectRoute project={project} locale="pt-BR" />
