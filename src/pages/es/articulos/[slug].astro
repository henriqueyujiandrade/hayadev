---
import type { GetStaticPaths } from 'astro';
import ArticleRoute from '@routes/ArticleRoute.astro';
import { articlePaths } from '@routes/paths';

export const getStaticPaths = (() => articlePaths('es')) satisfies GetStaticPaths;

const { article } = Astro.props;
---

<ArticleRoute article={article} locale="es" />
