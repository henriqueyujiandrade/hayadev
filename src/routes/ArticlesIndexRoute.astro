---
import ArticleCard from '@components/articles/ArticleCard.astro';
import ArticleSearch from '@components/articles/ArticleSearch.tsx';
import Container from '@components/ui/Container.astro';
import { ALL_FACET, normalizeForSearch } from '@components/ui/filterable';
import type { Locale } from '@config/locales';
import { ARTICLE_CATEGORIES } from '@config/taxonomy';
import PageLayout from '@layouts/PageLayout.astro';
import { useTranslations } from '@i18n/index';
import { getArticles } from '@utils/content';
import { homePath, localizedPath } from '@utils/routes';
import { buildAlternates, defaultOgImage, formatTitle, pathsForAllLocales } from '@utils/seo';
import { breadcrumbSchema, graph, personSchema, type BreadcrumbItem } from '@utils/structured-data';
import { absoluteUrl } from '@utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const articles = await getArticles(locale);

const categories = [
  { id: ALL_FACET, label: t.articles.filterAll, count: articles.length },
  ...ARTICLE_CATEGORIES.map((category) => ({
    id: category,
    label: t.categories[category],
    count: articles.filter((article) => article.data.category === category).length,
  })).filter((option) => option.count > 0),
];

const path = localizedPath('articles', locale);
const alternatePaths = pathsForAllLocales((target) => localizedPath('articles', target));
const { alternates, xDefault } = buildAlternates(alternatePaths);

const seo = {
  title: formatTitle(t.articles.title),
  description: t.articles.metaDescription,
  canonical: absoluteUrl(path),
  alternates,
  xDefault,
  ogType: 'website' as const,
  ogImage: defaultOgImage(),
  ogImageAlt: t.articles.title,
  noindex: false,
};

const breadcrumbs: BreadcrumbItem[] = [
  { name: t.nav.home, path: homePath(locale) },
  { name: t.articles.title, path },
];

const jsonLd = graph([personSchema(locale), breadcrumbSchema(breadcrumbs)]);

/** Everything an article can be matched against, normalized once at build. */
const searchKey = (article: (typeof articles)[number]): string =>
  normalizeForSearch(
    [article.data.title, article.data.description, ...article.data.tags].join(' '),
  );
---

<PageLayout
  locale={locale}
  seo={seo}
  jsonLd={jsonLd}
  alternatePaths={alternatePaths}
  title={t.articles.title}
  lead={t.articles.lead}
  eyebrow={t.nav.articles}
  breadcrumbs={breadcrumbs}
>
  <Container class="pt-10 pb-section">
    {articles.length === 0 ? (
      <div class="flex max-w-measure flex-col gap-2 rounded-xl border border-border bg-surface-muted/50 p-8">
        <p class="font-medium text-ink">{t.articles.empty}</p>
        <p class="text-ink-muted">{t.articles.emptyLead}</p>
      </div>
    ) : (
      <div class="max-w-content">
        <ArticleSearch
          client:idle
          categories={categories}
          searchLabel={t.articles.searchLabel}
          searchPlaceholder={t.articles.searchPlaceholder}
          clearLabel={t.articles.clearFilters}
          noResultsLabel={t.articles.noResults}
          resultsCountLabel={t.articles.resultsCount}
          resultsCountOneLabel={t.articles.resultsCountOne}
        >
          {articles.map((article) => (
            <div
              data-filterable
              data-facet={article.data.category}
              data-search={searchKey(article)}
            >
              <ArticleCard article={article} locale={locale} headingLevel="h2" />
            </div>
          ))}
        </ArticleSearch>
      </div>
    )}
  </Container>
</PageLayout>
